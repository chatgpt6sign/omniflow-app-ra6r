PORT=3000
NODE_ENV=development

# PostgreSQL database connection (OmniFlow provides this at deploy time)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret for login authentication — set a long random string
JWT_SECRET=change-me-to-a-long-random-string

# OmniFlow AI integration
OMNIFLOW_API_KEY=SHA256:ESZC1B6FcQzICQAs0knbWcRScNa7szgMliG8xZXMLfQ
OMNIFLOW_API_BASE_URL=https://app.omniflowai.com/api
LLM_MODEL_NAME=gpt-4o-mini

# Optional knowledge base config (JSON string)
# KNOWLEDGE_BASE_CONFIG={"knowledgeBases":[{"id":"kb-xxx","weight":1}]}
